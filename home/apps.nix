{ inputs, lib, pkgs, ... }:

let
  spicePkgs = inputs.spicetify-nix.legacyPackages.${pkgs.stdenv.hostPlatform.system};
in
{
  imports = [
    inputs.zen-browser.homeModules.beta
    inputs.spicetify-nix.homeManagerModules.default
  ];

  home.packages = [
    pkgs.vesktop     # Discord, with theme support
  ];

  # ---- Spotify, themed by Spicetify (the theme is fixed at build time: Spotify is read-only on NixOS) ----
  # To add a plugin: put its name in enabledExtensions, run `rebuild`, restart Spotify.
  programs.spicetify = {
    enable = true;
    theme = spicePkgs.themes.catppuccin;
    colorScheme = "mocha";
    enabledExtensions = with spicePkgs.extensions; [
      hidePodcasts
      shuffle
      adblockify
    ];
    # enabledCustomApps = with spicePkgs.apps; [ ];
  };

  # ---- Zen Browser: installed with only its profile mapping; everything else is configured inside Zen ----
  programs.zen-browser = {
    enable = true;
    profiles.default = {
      id = 0;
      isDefault = true;
    };
  };

  # ---- Colours for Vesktop from the wallpaper (added to matugen's own config) ----
  xdg.configFile."matugen/config.toml".text = ''

    [templates.vesktop]
    input_path = '~/.config/matugen/templates/vesktop.css'
    output_path = '~/.config/vesktop/settings/quickCss.css'
  '';

  xdg.configFile."matugen/templates/vesktop.css".text = ''
    /* Generated by matugen from the current wallpaper. Rewritten on every wallpaper change: do not edit. */
    .theme-dark,
    .theme-darker,
    .theme-midnight,
    .theme-light {
      /* classic names */
      --background-primary: {{ colors.surface.default.hex }};
      --background-secondary: {{ colors.surface_container_low.default.hex }};
      --background-secondary-alt: {{ colors.surface_container.default.hex }};
      --background-tertiary: {{ colors.surface_container_lowest.default.hex }};
      --background-floating: {{ colors.surface_container_high.default.hex }};
      --background-modifier-hover: {{ colors.surface_container_high.default.hex }}99;
      --background-modifier-selected: {{ colors.surface_container_highest.default.hex }};
      --background-modifier-accent: {{ colors.outline_variant.default.hex }}66;
      --channeltextarea-background: {{ colors.surface_container.default.hex }};
      --chat-background: {{ colors.surface.default.hex }};
      --text-normal: {{ colors.on_surface.default.hex }};
      --text-muted: {{ colors.on_surface_variant.default.hex }};
      --text-link: {{ colors.primary.default.hex }};
      --header-primary: {{ colors.on_surface.default.hex }};
      --header-secondary: {{ colors.on_surface_variant.default.hex }};
      --interactive-normal: {{ colors.on_surface_variant.default.hex }};
      --interactive-hover: {{ colors.on_surface.default.hex }};
      --interactive-active: {{ colors.primary.default.hex }};
      --brand-experiment: {{ colors.primary.default.hex }};
      --brand-500: {{ colors.primary.default.hex }};
      --brand-560: {{ colors.primary.default.hex }};

      /* newer names */
      --background-base-lowest: {{ colors.surface_container_lowest.default.hex }};
      --background-base-lower: {{ colors.surface_container_low.default.hex }};
      --background-base-low: {{ colors.surface_container.default.hex }};
      --background-surface-high: {{ colors.surface_container_high.default.hex }};
      --background-surface-higher: {{ colors.surface_container_highest.default.hex }};
      --background-surface-highest: {{ colors.surface_container_highest.default.hex }};
      --chat-background-default: {{ colors.surface.default.hex }};
      --text-default: {{ colors.on_surface.default.hex }};
      --text-strong: {{ colors.on_surface.default.hex }};
      --text-subtle: {{ colors.on_surface_variant.default.hex }};
      --text-brand: {{ colors.primary.default.hex }};
      --border-subtle: {{ colors.outline_variant.default.hex }};
    }
  '';

  # Vesktop's folder has to exist before matugen writes into it
  home.activation.appThemeDirs = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    run mkdir -p "$HOME/.config/vesktop/settings"
  '';
}
